    "G_optimizer_wd": 0,
    "G_optimizer_betas": [0.9, 0.999],

    "G_scheduler_type": "MultiStepLR",
    "G_scheduler_milestones": [30000, 60000, 90000],
    "G_scheduler_gamma": 0.5,

    "G_regularizer_clipgrad": 1.0,

    "total_iters": 100000,
    "checkpoint_test": 1000,
    "checkpoint_save": 5000,
